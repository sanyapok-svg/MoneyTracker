# URL проекта Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Публичный ключ (любое имя из пары):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Админка (PRD-3): email владельца = тот же, что при входе в приложение
# ADMIN_EMAIL=you@example.com

# Service role — только на сервере (админка, курсы НБ РБ в БД)
# SUPABASE_SERVICE_ROLE_KEY=

# Опционально: защита cron /api/cron/exchange-rates (Vercel передаёт Authorization)
# CRON_SECRET=

# Для корректного redirect OAuth в проде (опционально на localhost):
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Stripe — подписка на конвертацию RUB/KZT ($5/мес)
# https://docs.stripe.com/keys — только в .env.local, не коммитить!
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   # stripe listen --forward-to localhost:3000/api/stripe/webhook
# STRIPE_PRICE_ID=price_...         # опционально: Price из Dashboard; иначе создаётся автоматически
