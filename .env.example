# URL проекта Supabase
NEXT_PUBLIC_SUPABASE_URL=

# Публичный ключ (любое имя из пары):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Админка (PRD-3): email владельца = тот же, что при входе в приложение
# ADMIN_EMAIL=you@example.com

# Service role — только на сервере, для списка/бан/удаления пользователей (Settings → API)
# SUPABASE_SERVICE_ROLE_KEY=

# Для корректного redirect OAuth в проде (опционально на localhost):
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
